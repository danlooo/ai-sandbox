// Changes from upstream Anthropic template (github.com/anthropics/claude-code/tree/main/.devcontainer):
//   - Added: github.copilot and github.copilot-chat extensions
//   - Removed: claude-code-config volume mount (source=claude-code-config-${devcontainerId},
//     target=/home/vscode/.claude) — removed so the pre-configured settings.json baked into
//     the image is not shadowed by an empty volume on first run
//   - Removed: workspaceMount and workspaceFolder fields (devcontainer template format handles this)
//   - Added: chezmoi via Dockerfile (for dotfiles management)
//   - Changed: waitFor from postStartCommand to postCreateCommand — VS Code dotfiles (chezmoi apply)
//     run before the firewall so that plugin installation has internet access
//   - Changed: user from `node` to `vscode`, base image from node:20 to ubuntu:24.04 (see Dockerfile)
{
    "name": "Claude Code Sandbox",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "TZ": "${localEnv:TZ:America/Los_Angeles}",
            "CLAUDE_CODE_VERSION": "latest",
            "GIT_DELTA_VERSION": "0.18.2",
            "ZSH_IN_DOCKER_VERSION": "1.2.0"
        }
    },
    "runArgs": [
        "--read-only",
        "--tmpfs",
        "/tmp",
        "--tmpfs",
        "/home:mode=777",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "github.copilot",
                "github.copilot-chat",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "eamodio.gitlens",
                "ms-azuretools.vscode-docker",
                "saoudrizwan.claude-dev"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "esbenp.prettier-vscode",
                "editor.codeActionsOnSave": {
                    "source.fixAll.eslint": "explicit"
                },
                "terminal.integrated.defaultProfile.linux": "zsh",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "bash",
                        "icon": "terminal-bash"
                    },
                    "zsh": {
                        "path": "zsh"
                    }
                }
            }
        }
    },
    "remoteUser": "vscode",
    "mounts": [
        "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume"
    ],
    "containerEnv": {
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
    },
    "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
    "waitFor": "postCreateCommand"
}